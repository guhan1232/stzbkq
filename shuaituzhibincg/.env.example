# MySQL数据库配置
DB_HOST=your-mysql-host.com
DB_PORT=3306
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=your_database_name

# 服务配置
SERVER_PORT=9527

# Session密钥（生产环境请务必修改为复杂字符串）
# 可使用 openssl rand -base64 32 生成
SESSION_SECRET=your-very-secure-session-secret-key

# 安全配置
# 是否启用主机名检查（禁止IP直接访问，只允许域名访问）
# true: 启用，禁止通过 IP 地址访问
# false: 禁用，允许通过 IP 地址访问（默认）
ENABLE_HOST_CHECK=false
