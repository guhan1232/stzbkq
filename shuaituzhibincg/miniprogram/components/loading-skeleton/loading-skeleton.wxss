/* components/loading-skeleton/loading-skeleton.wxss */
.skeleton-container {
  width: 100%;
}

/* 通用骨架样式 */
.skeleton-line,
.skeleton-circle,
.skeleton-avatar,
.skeleton-image {
  background: linear-gradient(
    90deg,
    rgba(0, 0, 0, 0.05) 25%,
    rgba(0, 0, 0, 0.1) 50%,
    rgba(0, 0, 0, 0.05) 75%
  );
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: var(--radius-sm);
}

@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

/* 线条尺寸 */
.skeleton-line {
  height: 24rpx;
  margin-bottom: var(--space-sm);
}

.skeleton-line.very-short {
  width: 80rpx;
}

.skeleton-line.short {
  width: 40%;
}

.skeleton-line.medium {
  width: 70%;
}

.skeleton-line.long {
  width: 90%;
}

/* 圆形 */
.skeleton-circle {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-bottom: var(--space-sm);
}

.skeleton-circle.small {
  width: 40rpx;
  height: 40rpx;
}

/* 卡片骨架屏 */
.skeleton-card {
  display: flex;
  padding: var(--space-md);
  background: var(--bg-card);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-sm);
}

.skeleton-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: var(--space-md);
  flex-shrink: 0;
}

.skeleton-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* 列表项骨架屏 */
.skeleton-list-item {
  display: flex;
  align-items: center;
  padding: var(--space-md);
  background: var(--bg-card);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-sm);
}

.skeleton-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
  margin-right: var(--space-md);
  flex-shrink: 0;
}

.skeleton-text-group {
  flex: 1;
}

/* 统计网格骨架屏 */
.skeleton-stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-md);
  margin-bottom: var(--space-md);
}

.skeleton-stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-lg);
  background: var(--bg-card);
  border-radius: var(--radius-md);
}

/* 个人资料骨架屏 */
.skeleton-profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-xl);
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  margin-bottom: var(--space-md);
}

.skeleton-large-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: var(--space-md);
}

.skeleton-profile-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--space-lg);
}

.skeleton-profile-stats {
  display: flex;
  justify-content: space-around;
  width: 100%;
  padding-top: var(--space-md);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.skeleton-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-xs);
}
