.task-card {
  position: relative;
  display: flex;
  align-items: stretch;
  background: var(--bg-card);
  border-radius: var(--radius-2xl);
  padding: var(--space-md);
  margin-bottom: var(--space-sm);
  box-shadow: var(--shadow-soft);
  transition: all var(--transition-base);
  border: 2rpx solid var(--border-color);
  overflow: hidden;
}

.task-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
}

.task-card.success {
  border-color: var(--success-light);
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.2);
}

.task-card.warning {
  border-color: var(--warning-light);
  box-shadow: 0 4rpx 16rpx rgba(255, 217, 61, 0.2);
}

.task-card.error {
  border-color: var(--danger-light);
  box-shadow: 0 4rpx 16rpx rgba(244, 67, 54, 0.2);
}

.card-status-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--space-sm);
  position: relative;
  z-index: 1;
}

.indicator-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--warning);
  border: 2rpx solid white;
}

.task-card.success .indicator-dot {
  background: var(--success);
}

.task-card.error .indicator-dot {
  background: var(--danger);
}

.card-content {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-xs);
}

.card-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: var(--space-sm);
}

.card-badge {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-2xl);
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
  background: rgba(255, 217, 61, 0.15);
  color: var(--warning);
  border: 2rpx solid rgba(255, 217, 61, 0.3);
}

.card-badge.success {
  background: rgba(76, 175, 80, 0.15);
  color: var(--success);
  border-color: rgba(76, 175, 80, 0.3);
}

.card-badge.error {
  background: rgba(244, 67, 54, 0.15);
  color: var(--danger);
  border-color: rgba(244, 67, 54, 0.3);
}

.card-info {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-bottom: var(--space-xs);
}

.info-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: var(--bg-secondary);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--border-color);
}

.info-icon {
  font-size: 26rpx;
  color: var(--primary-500);
}

.info-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.card-description {
  display: block;
  font-size: 28rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
  margin-top: var(--space-xs);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-progress {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-top: var(--space-sm);
  position: relative;
  z-index: 1;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-2xl);
  overflow: hidden;
  border: 2rpx solid var(--border-color);
}

.progress-fill {
  height: 100%;
  border-radius: var(--radius-2xl);
  transition: width var(--transition-base);
  background: linear-gradient(90deg, var(--warning) 0%, var(--warning-light) 100%);
}

.progress-fill.success {
  background: linear-gradient(90deg, var(--success) 0%, var(--success-light) 100%);
}

.progress-fill.error {
  background: linear-gradient(90deg, var(--danger) 0%, var(--danger-light) 100%);
}

.progress-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  min-width: 60rpx;
  text-align: right;
  font-weight: 600;
}

.card-footer {
  margin-top: var(--space-sm);
  padding-top: var(--space-sm);
  border-top: 2rpx solid var(--border-color);
  position: relative;
  z-index: 1;
}

.participants {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: var(--bg-secondary);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--border-color);
  width: fit-content;
}

.participant-icon {
  font-size: 26rpx;
  color: var(--primary-500);
}

.participant-count {
  font-size: 26rpx;
  color: var(--text-tertiary);
  font-weight: 500;
}

.card-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: var(--space-sm);
  font-size: 52rpx;
  color: var(--text-tertiary);
  font-weight: 300;
  position: relative;
  z-index: 1;
}

.task-card.compact {
  padding: var(--space-sm);
  margin-bottom: var(--space-xs);
  border-radius: var(--radius-xl);
}

.task-card.compact .card-title {
  font-size: 30rpx;
}

.task-card.compact .card-description {
  display: none;
}

.task-card.compact .card-footer {
  display: none;
}

@media (max-width: 375px) {
  .card-title {
    font-size: 32rpx;
  }

  .card-badge {
    font-size: 22rpx;
    padding: 6rpx 16rpx;
  }

  .info-text {
    font-size: 24rpx;
  }

  .card-description {
    font-size: 26rpx;
  }

  .progress-text {
    font-size: 24rpx;
  }

  .participant-count {
    font-size: 24rpx;
  }

  .card-arrow {
    font-size: 48rpx;
  }
}
