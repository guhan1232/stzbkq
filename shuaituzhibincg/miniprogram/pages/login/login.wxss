.login-page {
  min-height: 100vh;
  background: var(--bg-gradient);
  display: flex;
  flex-direction: column;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
  padding-bottom: 100rpx;
}

.logo-circle {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, var(--primary-500) 0%, var(--primary-300) 100%);
  border-radius: var(--radius-3xl);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-glow);
  margin-bottom: 40rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.6);
}

.logo-icon {
  font-size: 96rpx;
  color: white;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.app-name {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.app-slogan {
  font-size: 30rpx;
  color: var(--text-secondary);
  text-align: center;
  padding: 0 var(--space-lg);
}

.login-form {
  padding: 0 50rpx;
}

.input-group {
  display: flex;
  align-items: center;
  background-color: var(--bg-card);
  border-radius: var(--radius-2xl);
  padding: 0 28rpx;
  margin-bottom: 28rpx;
  border: 2rpx solid var(--border-color);
  box-shadow: var(--shadow-soft);
  transition: all var(--transition-base);
}

.input-group:focus-within {
  border-color: var(--primary-300);
  box-shadow: 0 0 0 8rpx rgba(168, 134, 85, 0.1);
}

.input-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  opacity: 0.7;
  color: var(--primary-500);
}

.input-field {
  flex: 1;
  height: 100rpx;
  font-size: 32rpx;
  color: var(--text-primary);
}

.input-placeholder {
  color: var(--text-tertiary);
}

.input-toggle {
  font-size: 36rpx;
  padding: 16rpx;
  color: var(--text-secondary);
  transition: all var(--transition-base);
}

.input-toggle:active {
  transform: scale(0.9);
  color: var(--primary-500);
}

.login-btn {
  width: 100%;
  height: 108rpx;
  background: linear-gradient(135deg, var(--primary-500) 0%, var(--primary-300) 100%);
  border-radius: var(--radius-2xl);
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-white);
  border: none;
  margin-top: 48rpx;
  box-shadow: var(--shadow-glow);
  transition: all var(--transition-base);
}

.login-btn::after {
  border: none !important;
}

.login-btn:active {
  transform: scale(0.96);
  box-shadow: var(--shadow-md);
}

.login-btn.loading {
  opacity: 0.7;
}

.register-link {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 48rpx;
}

.link-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.link-action {
  font-size: 28rpx;
  color: var(--primary-500);
  margin-left: 8rpx;
  font-weight: 500;
  transition: all var(--transition-base);
}

.link-action:active {
  transform: scale(1.05);
  color: var(--primary-600);
}

.register-form {
  padding: 20rpx 30rpx;
}

.register-field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.field-input {
  width: 100%;
  height: 88rpx;
  background-color: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  border: 2rpx solid var(--border-color);
  box-shadow: var(--shadow-soft);
  transition: all var(--transition-base);
}

.field-input:focus {
  border-color: var(--primary-300);
  box-shadow: 0 0 0 8rpx rgba(168, 134, 85, 0.1);
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto;
}

.error-message {
  font-size: 26rpx;
  color: var(--danger);
  margin-bottom: var(--space-md);
  text-align: center;
  padding: var(--space-sm);
  background: var(--danger-bg);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--danger-light);
}

@media (max-width: 375px) {
  .logo-circle {
    width: 176rpx;
    height: 176rpx;
  }

  .logo-icon {
    font-size: 88rpx;
  }

  .app-name {
    font-size: 48rpx;
  }

  .input-field {
    font-size: 30rpx;
  }

  .login-btn {
    font-size: 32rpx;
  }
}
