.page-container {
  min-height: 100vh;
  background: var(--bg-gradient);
  padding: 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.header-section {
  background: linear-gradient(135deg, var(--primary-500), var(--primary-700));
  padding: 60rpx var(--space-lg) 40rpx;
  color: var(--text-white);
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--primary-500);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.database-list {
  padding: var(--space-lg);
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.list-title {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.list-count {
  font-size: 24rpx;
  color: var(--primary-500);
  background-color: var(--primary-50);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.database-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
  border: 2rpx solid var(--border-color);
  transition: all var(--transition-base);
}

.database-card:active {
  background-color: var(--bg-hover);
  transform: scale(0.98);
}

.database-card.selected {
  border-color: var(--primary-300);
  box-shadow: 0 4rpx 20rpx rgba(168, 134, 85, 0.15);
}

.database-card.selected::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, var(--primary-500), var(--primary-300));
}

.card-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.card-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-500), var(--primary-300));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow-md);
}

.database-card.selected .card-icon {
  box-shadow: 0 4rpx 16rpx rgba(168, 134, 85, 0.4);
}

.card-info {
  display: flex;
  flex-direction: column;
}

.card-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.card-alliance {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.card-right {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.status-badge {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background-color: var(--primary-50);
  color: var(--primary-500);
  font-weight: 500;
}

.status-badge.active {
  background-color: var(--primary-100);
  color: var(--primary-600);
  font-weight: 600;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 32rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 40rpx;
}

.refresh-btn {
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, var(--primary-500), var(--primary-300));
  color: var(--text-white);
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 36rpx;
  text-align: center;
  border: none;
  box-shadow: var(--shadow-md);
}

.refresh-btn::after {
  border: none;
}

.refresh-btn:active {
  opacity: 0.85;
}

.logout-section {
  padding: var(--space-lg);
  padding-bottom: calc(var(--space-xl) + env(safe-area-inset-bottom));
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: var(--danger-bg);
  color: var(--danger);
  font-size: 30rpx;
  font-weight: 500;
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--danger-light);
  text-align: center;
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  background-color: rgba(197, 48, 48, 0.2);
}
