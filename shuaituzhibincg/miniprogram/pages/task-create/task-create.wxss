.container {
  min-height: 100vh;
  background: var(--bg-gradient);
  padding: var(--space-lg);
}

.form-group {
  margin-bottom: var(--space-lg);
}

.form-label {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: var(--space-sm);
  font-weight: 600;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 0 var(--space-lg);
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  border: 2rpx solid var(--border-color);
  transition: border-color var(--transition-base);
}

.form-input:focus {
  border-color: var(--primary-400);
}

.form-picker {
  width: 100%;
  height: 88rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 0 var(--space-lg);
  font-size: 28rpx;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border: 2rpx solid var(--border-color);
}

.quick-time-options {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}

.quick-time-item {
  padding: var(--space-sm) var(--space-md);
  background: var(--bg-card);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  border: 2rpx solid var(--border-color);
  color: var(--text-secondary);
  transition: all var(--transition-base);
}

.quick-time-item:active {
  background: var(--primary-50);
  border-color: var(--primary-500);
  color: var(--primary-500);
  transform: scale(0.98);
}

.placeholder {
  color: var(--text-tertiary);
}

.picker-arrow {
  color: var(--text-tertiary);
  font-size: 24rpx;
}

.coord-inputs {
  display: flex;
  gap: var(--space-md);
}

.coord-input {
  flex: 1;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  border: 2rpx solid var(--border-color);
}

.checkbox-group {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.checkbox-item {
  display: flex;
  align-items: center;
  padding: var(--space-sm) var(--space-md);
  background: var(--bg-card);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  border: 2rpx solid var(--border-color);
  color: var(--text-secondary);
  transition: all var(--transition-base);
}

.checkbox-item.checked {
  background: var(--primary-50);
  border-color: var(--primary-500);
  color: var(--primary-500);
}

.checkbox-icon {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--space-sm);
  font-size: 20rpx;
}

.checkbox-item.checked .checkbox-icon {
  background: var(--primary-500);
  border-color: var(--primary-500);
  color: #fff;
}

.checkbox-text {
  font-size: 26rpx;
}

.no-groups {
  padding: var(--space-md);
}

.no-groups-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.form-actions {
  margin-top: var(--space-2xl);
  padding: 0 var(--space-lg);
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--primary-500), var(--primary-700));
  color: #fff;
  font-size: 30rpx;
  border-radius: var(--radius-md);
  border: none;
  box-shadow: var(--shadow-md);
}

.btn-submit:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-submit[loading] {
  opacity: 0.6;
}
