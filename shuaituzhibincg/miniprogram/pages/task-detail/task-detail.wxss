.detail-page {
  min-height: 100vh;
  background: var(--bg-gradient);
  padding-bottom: 40rpx;
}

.task-header {
  background: var(--gradient-primary);
  padding: 48rpx 32rpx;
  color: var(--text-white);
}

.task-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.task-name {
  font-size: 36rpx;
  font-weight: 600;
  flex: 1;
}

.task-status {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: var(--radius-full);
  background-color: rgba(255, 255, 255, 0.2);
  font-weight: 500;
}

.task-status.completed {
  background-color: rgba(255, 255, 255, 0.3);
}

.task-meta {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  opacity: 0.95;
}

.meta-icon {
  margin-right: 12rpx;
}

.stats-card {
  margin: -30rpx 24rpx 24rpx;
  background-color: var(--bg-card);
  border-radius: var(--radius-2xl);
  padding: 32rpx;
  box-shadow: var(--shadow-lg);
  border: 2rpx solid var(--border-color);
  position: relative;
  z-index: 2;
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.stats-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.stats-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.progress-section {
  margin-bottom: 32rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.progress-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.progress-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-500);
}

.progress-bar {
  height: 16rpx;
  background-color: var(--primary-50);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--gradient-primary);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  background-color: var(--primary-50);
  border-radius: var(--radius-xl);
  border: 2rpx solid var(--border-color);
}

.stat-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.stat-number {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.action-section {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  gap: 20rpx;
}

.primary-btn, .secondary-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-xl);
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.primary-btn {
  background: var(--gradient-primary);
  color: var(--text-white);
  box-shadow: var(--shadow-glow);
}

.primary-btn::after {
  border: none;
}

.secondary-btn {
  background-color: var(--bg-card);
  color: var(--primary-500);
  border: 2rpx solid var(--border-color-medium);
}

.secondary-btn::after {
  border: none;
}

.btn-icon {
  margin-right: 8rpx;
}

.enable-btn, .disable-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-xl);
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.enable-btn {
  background: var(--gradient-primary);
  color: var(--text-white);
  box-shadow: var(--shadow-glow);
}

.enable-btn::after {
  border: none;
}

.disable-btn {
  background-color: var(--danger-bg);
  color: var(--danger);
  border: 2rpx solid var(--danger-bg);
}

.disable-btn::after {
  border: none;
}

.delete-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-xl);
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--danger-bg);
  color: var(--danger);
  border: 2rpx solid var(--danger-bg);
}

.delete-btn::after {
  border: none;
}

.tab-container {
  margin: 0 24rpx;
}

.tab-header {
  display: flex;
  background-color: var(--bg-card);
  border-radius: var(--radius-2xl) var(--radius-2xl) 0 0;
  overflow: hidden;
  box-shadow: var(--shadow-xs);
}

.tab-item {
  flex: 1;
  padding: 28rpx 0;
  text-align: center;
  position: relative;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: var(--gradient-primary);
  border-radius: 3rpx;
}

.tab-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.tab-item.active .tab-text {
  color: var(--primary-500);
  font-weight: 600;
}

.filter-bar {
  display: flex;
  white-space: nowrap;
  padding: 16rpx 8rpx 0;
  background-color: var(--bg-card);
}

.filter-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-full);
  background-color: var(--bg-secondary);
  border: 2rpx solid var(--border-color);
  flex-shrink: 0;
  transition: all var(--transition-base);
}

.filter-item.active {
  background: var(--gradient-primary);
  border-color: transparent;
  box-shadow: var(--shadow-glow);
}

.filter-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.filter-item.active .filter-text {
  color: var(--text-white);
  font-weight: 500;
}

.filter-count {
  font-size: 22rpx;
  color: var(--text-secondary);
  background-color: var(--primary-50);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.filter-item.active .filter-count {
  color: rgba(255, 255, 255, 0.85);
  background-color: rgba(255, 255, 255, 0.2);
}

.members-section {
  background-color: var(--bg-card);
  border-radius: 0 0 var(--radius-2xl) var(--radius-2xl);
  overflow: hidden;
  box-shadow: var(--shadow-xs);
}

.group-section {
  margin-bottom: 16rpx;
}

.group-section:last-child {
  margin-bottom: 0;
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: var(--primary-50);
  border-top: 2rpx solid var(--border-color-medium);
  border-bottom: 2rpx solid var(--border-color-medium);
}

.group-section:first-child .group-header {
  border-top: none;
}

.group-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-500);
}

.group-count {
  font-size: 24rpx;
  color: var(--text-secondary);
  background-color: var(--primary-100);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.members-list {
  overflow-y: auto;
}

.member-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.member-card:last-child {
  border-bottom: none;
}

.member-info {
  display: flex;
  align-items: center;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--gradient-primary);
  color: var(--text-white);
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.member-avatar.absent {
  background: linear-gradient(135deg, #BDC3C7, #95A5A6);
}

.member-avatar.leave {
  background: linear-gradient(135deg, #f59e0b, #d97706);
}

.member-detail {
  display: flex;
  flex-direction: column;
}

.member-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.member-group {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.member-reason {
  font-size: 22rpx;
  color: #d97706;
  margin-top: 4rpx;
}

.member-stats {
  display: flex;
  gap: 12rpx;
}

.stat-tag {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.stat-tag.atk {
  background-color: var(--warning-bg);
  color: var(--warning);
}

.stat-tag.dis {
  background-color: var(--info-bg);
  color: var(--info);
}

.member-badge {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.member-badge.absent {
  background-color: var(--danger-bg);
  color: var(--danger);
}

.member-card.leave {
  background-color: #fffbeb;
}

.mini-action-btn {
  margin: 0 0 0 16rpx;
  padding: 8rpx 18rpx;
  min-width: 92rpx;
  line-height: 1.4;
  border-radius: 8rpx;
  background-color: #f3f4f6;
  color: var(--text-secondary);
  font-size: 22rpx;
}

.mini-action-btn.leave-btn {
  background-color: #fffbeb;
  color: #d97706;
}

.mini-action-btn::after {
  border: none;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-secondary);
  font-size: 28rpx;
}
