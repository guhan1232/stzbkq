.container {
  min-height: 100vh;
  background-color: var(--bg-secondary);
}

.content {
  padding: 20rpx;
}

.info-card {
  background: var(--gradient-primary);
  border-radius: var(--radius-lg);
  padding: 30rpx;
  margin-bottom: 20rpx;
  color: white;
}

.info-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.info-text {
  font-size: 26rpx;
  line-height: 1.6;
  opacity: 0.95;
}

.format-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
}

.button-group {
  margin: 30rpx 0;
}

.button-group .van-button {
  margin-bottom: 20rpx;
}

.stats-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-soft);
}

.stats-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.stat-item {
  text-align: center;
  padding: 20rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--primary-500);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.usage-card {
  background: var(--success-bg);
  border-left: 6rpx solid var(--success);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.usage-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--success);
  margin-bottom: 16rpx;
}

.usage-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.usage-item {
  font-size: 24rpx;
  color: var(--success);
  line-height: 1.6;
}

.example-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-soft);
}

.example-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.example-code {
  background: var(--bg-secondary);
  border-radius: var(--radius-sm);
  padding: 20rpx;
  font-size: 22rpx;
  color: var(--text-primary);
  line-height: 1.8;
  overflow-x: auto;
  font-family: 'Courier New', monospace;
}

.preview-container {
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.preview-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.preview-content {
  flex: 1;
  padding: 20rpx;
  background: var(--bg-secondary);
}

.preview-content pre {
  font-size: 22rpx;
  color: var(--text-primary);
  line-height: 1.6;
  white-space: pre-wrap;
  word-wrap: break-word;
  font-family: 'Courier New', monospace;
}
