<!-- 首页 - 清新渐变风格 -->
<view class="page-container">
  <!-- 顶部渐变头部 -->
  <view class="header-section">
    <!-- 定位/同盟选择器 -->
    <view class="location-bar" bindtap="onSelectDatabase">
      <text class="location-icon">📍</text>
      <text class="location-text">{{databaseAlliance || databaseName || '选择同盟'}}</text>
      <text wx:if="{{databaseServer}}" class="location-server">[{{databaseServer}}]</text>
      <text class="location-arrow">›</text>
    </view>
    
    <!-- 标题 -->
    <view class="header-title">
      <text class="app-title">率土之滨助手</text>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input">
      <text class="search-icon">🔍</text>
      <input placeholder="搜索任务或成员" class="search-field" />
      <text class="search-voice">🎤</text>
    </view>
  </view>

  <!-- 数据概览卡片 -->
  <view class="stats-overview">
    <stat-card 
      title="同盟成员" 
      value="{{stats.memberCount || 0}}" 
      icon="⚔️"
      color="primary"
    />
    <stat-card 
      title="任务总数" 
      value="{{stats.taskCount || 0}}" 
      icon="📋"
      color="success"
    />
    <stat-card 
      title="战报记录" 
      value="{{stats.battleCount || 0}}" 
      icon="📊"
      color="info"
    />
    <stat-card 
      title="攻城战报" 
      value="{{stats.reportCount || 0}}" 
      icon="📄"
      color="warning"
    />
  </view>

  <!-- 快捷功能 -->
  <view class="quick-section">
    <view class="section-header">
      <text class="section-title">快捷功能</text>
      <view class="title-line"></view>
      <text class="section-more" data-url="/pages/task-create/task-create" bindtap="onNavigateTo">创建</text>
    </view>
    <view class="quick-grid">
      <view class="quick-item" data-url="/pages/task-create/task-create" bindtap="onNavigateTo">
        <view class="quick-icon" style="background: var(--gradient-primary);">
          <text>📝</text>
        </view>
        <text class="quick-name">创建任务</text>
      </view>
      <view class="quick-item" data-url="/pages/land-rank/land-rank" bindtap="onNavigateTo">
        <view class="quick-icon" style="background: var(--gradient-orange);">
          <text>🏆</text>
        </view>
        <text class="quick-name">土地排名</text>
      </view>
      <view class="quick-item" data-url="/pages/team-query/team-query" bindtap="onNavigateTo">
        <view class="quick-icon" style="background: var(--gradient-info);">
          <text>👥</text>
        </view>
        <text class="quick-name">队伍查询</text>
      </view>
      <view class="quick-item" data-url="/pages/battle-report/battle-report" bindtap="onNavigateTo">
        <view class="quick-icon" style="background: var(--gradient-warning);">
          <text>📊</text>
        </view>
        <text class="quick-name">战报统计</text>
      </view>
      <view class="quick-item" data-url="/pages/land-records/land-records" bindtap="onNavigateTo">
        <view class="quick-icon" style="background: var(--gradient-danger);">
          <text>🌍</text>
        </view>
        <text class="quick-name">翻地记录</text>
      </view>
      <view class="quick-item" data-url="/pages/team/team" bindtap="onNavigateTo">
        <view class="quick-icon" style="background: var(--gradient-purple);">
          <text>🏰</text>
        </view>
        <text class="quick-name">同盟管理</text>
      </view>
      <view class="quick-item" data-url="/pages/packet-view/packet-view" bindtap="onNavigateTo">
        <view class="quick-icon" style="background: var(--gradient-info);">
          <text>📡</text>
        </view>
        <text class="quick-name">数据捕获</text>
      </view>
      <view class="quick-item" data-url="/pages/leaderboard/leaderboard" bindtap="onNavigateTo">
        <view class="quick-icon" style="background: var(--gradient-success);">
          <text>🎖️</text>
        </view>
        <text class="quick-name">排行榜</text>
      </view>
      <view class="quick-item" data-url="/pages/chat-message/chat-message" bindtap="onNavigateTo">
        <view class="quick-icon" style="background: var(--gradient-purple);">
          <text>💬</text>
        </view>
        <text class="quick-name">聊天消息</text>
      </view>
    </view>
  </view>

  <!-- 最近任务 -->
  <view class="recent-section">
    <view class="section-header">
      <text class="section-title">最近任务</text>
      <view class="title-line"></view>
      <text class="section-more" data-url="/pages/task/task" bindtap="onNavigateTo">查看全部</text>
    </view>
    
    <view wx:if="{{recentTasks.length > 0}}" class="task-list">
      <view 
        wx:for="{{recentTasks}}" 
        wx:key="id" 
        class="task-card animate-slide-up"
        style="animation-delay: {{index * 0.05}}s"
        data-id="{{item.id}}"
        bindtap="onTaskDetail"
      >
        <view class="task-status-indicator {{item.statusClass}}"></view>
        <view class="task-info">
          <text class="task-name">{{item.title}}</text>
          <text class="task-time">{{item.timeStr}}</text>
        </view>
        <view class="task-right">
          <text class="task-badge {{item.statusClass}}">{{item.statusText}}</text>
          <text class="task-arrow">›</text>
        </view>
      </view>
    </view>

    <empty-state 
      wx:else
      icon="📭"
      title="暂无任务记录"
      description="还没有创建任何攻城任务"
    />
  </view>

  <!-- 底部间距 -->
  <view style="height: 40rpx;"></view>
</view>
