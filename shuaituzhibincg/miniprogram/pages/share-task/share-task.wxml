<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-text">加载中...</view>
  </view>

  <!-- 任务详情 -->
  <view wx:elif="{{task}}" class="content">
    <!-- 任务信息卡片 -->
    <view class="task-card">
      <view class="task-header">
        <view class="task-name">{{task.name}}</view>
        <view class="task-status">查看详情</view>
      </view>

      <view class="task-info">
        <view class="info-row">
          <text class="info-label">任务时间</text>
          <text class="info-value">{{task.timeStr}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">目标坐标</text>
          <text class="info-value">{{task.posStr}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">目标分组</text>
          <text class="info-value">{{task.targetStr || '全部'}}</text>
        </view>
      </view>

      <!-- 参与统计 -->
      <view class="stats-bar" wx:if="{{stats}}">
        <view class="stat-item">
          <text class="stat-num">{{stats.attended}}</text>
          <text class="stat-label">已参与</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{stats.notAttended}}</text>
          <text class="stat-label">未参与</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{stats.total}}</text>
          <text class="stat-label">战报数</text>
        </view>
      </view>
    </view>

    <!-- Tab切换 -->
    <view class="tab-container">
      <view class="tab-header">
        <view class="tab-item {{activeTab === 'attended' ? 'active' : ''}}" bindtap="switchTab" data-tab="attended">
          <text class="tab-text">已到 {{attendedList.length}}人</text>
        </view>
        <view class="tab-item {{activeTab === 'absent' ? 'active' : ''}}" bindtap="switchTab" data-tab="absent">
          <text class="tab-text">未到 {{absentList.length}}人</text>
        </view>
      </view>

      <!-- 团筛选栏（已到） -->
      <scroll-view wx:if="{{activeTab === 'attended'}}" scroll-x class="filter-bar" enhanced show-scrollbar="false" enable-flex>
        <view class="filter-item {{filterGroup === '' ? 'active' : ''}}" bindtap="switchFilterGroup" data-group="">
          <text class="filter-text">全部人员</text>
          <text class="filter-count">{{attendedList.length}}人</text>
        </view>
        <block wx:for="{{attendedGroups}}" wx:key="name">
          <view class="filter-item {{filterGroup === item.name ? 'active' : ''}}" bindtap="switchFilterGroup" data-group="{{item.name}}">
            <text class="filter-text">{{item.name}}</text>
            <text class="filter-count">{{item.count}}人</text>
          </view>
        </block>
      </scroll-view>

      <!-- 团筛选栏（未到） -->
      <scroll-view wx:if="{{activeTab === 'absent'}}" scroll-x class="filter-bar" enhanced show-scrollbar="false" enable-flex>
        <view class="filter-item {{filterGroup === '' ? 'active' : ''}}" bindtap="switchFilterGroup" data-group="">
          <text class="filter-text">全部人员</text>
          <text class="filter-count">{{absentList.length}}人</text>
        </view>
        <block wx:for="{{absentGroups}}" wx:key="name">
          <view class="filter-item {{filterGroup === item.name ? 'active' : ''}}" bindtap="switchFilterGroup" data-group="{{item.name}}">
            <text class="filter-text">{{item.name}}</text>
            <text class="filter-count">{{item.count}}人</text>
          </view>
        </block>
      </scroll-view>

      <!-- 已到人员列表 -->
      <view wx:if="{{activeTab === 'attended'}}" class="members-section">
        <view class="group-section" wx:for="{{attendedDisplayGroups}}" wx:key="name">
          <view class="group-header">
            <text class="group-name">{{item.name}}</text>
            <text class="group-count">{{item.count}}人</text>
          </view>
          <view class="members-list">
            <view class="member-card attended" wx:for="{{item.list}}" wx:for-item="user" wx:key="name">
              <view class="member-info">
                <view class="member-avatar">{{user.firstChar || '?'}}</view>
                <view class="member-detail">
                  <text class="member-name">{{user.name}}</text>
                  <text class="member-group">{{user.group}}</text>
                </view>
              </view>
              <view class="member-stats">
                <view class="stat-tag atk" wx:if="{{user.atk_num > 0}}">
                  <text>攻城 {{user.atk_num}}</text>
                </view>
                <view class="stat-tag dis" wx:if="{{user.dis_num > 0}}">
                  <text>拆迁 {{user.dis_num}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view class="empty-tip" wx:if="{{attendedDisplayGroups.length === 0}}">
          <text>暂无已到人员</text>
        </view>
      </view>

      <!-- 未到人员列表 -->
      <view wx:if="{{activeTab === 'absent'}}" class="members-section">
        <view class="group-section" wx:for="{{absentDisplayGroups}}" wx:key="name">
          <view class="group-header">
            <text class="group-name">{{item.name}}</text>
            <text class="group-count">{{item.count}}人</text>
          </view>
          <view class="members-list">
            <view class="member-card absent" wx:for="{{item.list}}" wx:for-item="user" wx:key="name">
              <view class="member-info">
                <view class="member-avatar absent">{{user.firstChar || '?'}}</view>
                <view class="member-detail">
                  <text class="member-name">{{user.name}}</text>
                  <text class="member-group">{{user.group}}</text>
                </view>
              </view>
              <view class="member-badge absent">
                <text>未参与</text>
              </view>
            </view>
          </view>
        </view>
        <view class="empty-tip" wx:if="{{absentDisplayGroups.length === 0}}">
          <text>太棒了！全员到齐</text>
        </view>
      </view>
    </view>

    <!-- 分享提示 -->
    <view class="share-tips">
      <text>长按右上角分享给好友</text>
    </view>
  </view>

  <!-- 无数据 -->
  <view wx:else class="empty">
    <view class="empty-icon">📭</view>
    <view class="empty-text">任务不存在或已删除</view>
  </view>
</view>
