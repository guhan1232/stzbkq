.container {
  padding: 20rpx;
  background: var(--bg-secondary);
  min-height: 100vh;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}

.loading-text {
  color: var(--text-tertiary);
  font-size: 28rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  color: var(--text-tertiary);
  font-size: 28rpx;
}

.task-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-soft);
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border-color);
  margin-bottom: 20rpx;
}

.task-name {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.task-status {
  font-size: 24rpx;
  color: var(--primary-500);
  background: var(--primary-50);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
}

.task-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

.info-value {
  font-size: 28rpx;
  color: var(--text-primary);
}

.stats-bar {
  display: flex;
  justify-content: space-around;
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid var(--border-color);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--primary-500);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

.tab-container {
  margin: 0 0 20rpx;
}

.tab-header {
  display: flex;
  background: var(--bg-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  padding: 28rpx 0;
  text-align: center;
  position: relative;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: var(--gradient-primary);
  border-radius: 3rpx;
}

.tab-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

.tab-item.active .tab-text {
  color: var(--primary-500);
  font-weight: 600;
}

.filter-bar {
  display: flex;
  white-space: nowrap;
  padding: 16rpx 8rpx 0;
  background: var(--bg-card);
}

.filter-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-full);
  background-color: var(--primary-50);
  border: 1rpx solid var(--border-color-light);
  flex-shrink: 0;
}

.filter-item.active {
  background: var(--gradient-primary);
  border-color: transparent;
}

.filter-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.filter-item.active .filter-text {
  color: #FFFFFF;
  font-weight: 500;
}

.filter-count {
  font-size: 22rpx;
  color: var(--text-tertiary);
  background-color: var(--bg-secondary);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.filter-item.active .filter-count {
  color: rgba(255, 255, 255, 0.85);
  background-color: rgba(255, 255, 255, 0.2);
}

.members-section {
  background: var(--bg-card);
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  overflow: hidden;
}

.group-section {
  margin-bottom: 0;
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: var(--primary-50);
  border-top: 1rpx solid var(--border-color-light);
  border-bottom: 1rpx solid var(--border-color-light);
}

.group-section:first-child .group-header {
  border-top: none;
}

.group-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-500);
}

.group-count {
  font-size: 24rpx;
  color: var(--text-tertiary);
  background-color: var(--bg-secondary);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
}

.members-list {
  overflow-y: auto;
}

.member-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--border-color-light);
}

.member-card:last-child {
  border-bottom: none;
}

.member-info {
  display: flex;
  align-items: center;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--gradient-primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.member-avatar.absent {
  background: var(--bg-secondary);
  color: var(--text-tertiary);
}

.member-detail {
  display: flex;
  flex-direction: column;
}

.member-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.member-group {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.member-stats {
  display: flex;
  gap: 12rpx;
}

.stat-tag {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
}

.stat-tag.atk {
  background-color: var(--warning-bg);
  color: var(--warning);
}

.stat-tag.dis {
  background-color: var(--info-bg);
  color: var(--info);
}

.member-badge {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
}

.member-badge.absent {
  background-color: var(--danger-bg);
  color: var(--danger);
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-tertiary);
  font-size: 28rpx;
}

.share-tips {
  text-align: center;
  padding: 30rpx;
  color: var(--text-tertiary);
  font-size: 26rpx;
}
