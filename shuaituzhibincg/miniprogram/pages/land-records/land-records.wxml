<view class="container">
  <!-- 顶部操作栏 -->
  <view class="action-bar">
    <view class="filter-btn" bindtap="toggleFilterPanel">
      <text class="icon">🔍</text>
      <text>筛选</text>
    </view>
    <view class="record-count-info">
      <text>共 {{total}} 条</text>
    </view>
  </view>

  <!-- 筛选面板 -->
  <view wx:if="{{showFilterPanel}}" class="filter-panel">
    <view class="filter-section">
      <view class="filter-title">基本筛选</view>
      
      <!-- 同盟成员开关 -->
      <view class="filter-item">
        <text class="filter-label">仅同盟成员</text>
        <switch checked="{{onlyMembers}}" bindchange="onOnlyMembersChange" />
      </view>
      
      <!-- 按团筛选 -->
      <view class="filter-item">
        <text class="filter-label">按团筛选</text>
        <input class="filter-input" placeholder="输入团名" value="{{groupName}}" bindinput="onGroupNameInput" />
      </view>
      
      <!-- 玩家名称 -->
      <view class="filter-item">
        <text class="filter-label">玩家名称</text>
        <input class="filter-input" placeholder="搜索玩家" value="{{playerName}}" bindinput="onPlayerNameInput" />
      </view>
      
      <!-- 结果筛选 -->
      <view class="filter-item">
        <text class="filter-label">结果</text>
        <picker mode="selector" range="{{['全部', '成功', '失败']}}" value="{{successFilterIndex}}" bindchange="onSuccessFilterChange">
          <view class="picker-value">
            {{successFilterText}}
          </view>
        </picker>
      </view>
    </view>
    
    <view class="filter-section">
      <view class="filter-title">时间范围</view>
      
      <!-- 开始日期 -->
      <view class="filter-item">
        <text class="filter-label">开始日期</text>
        <picker mode="date" value="{{startTime}}" bindchange="onStartTimeChange">
          <view class="picker-value">
            {{startTime || '选择日期'}}
          </view>
        </picker>
      </view>
      
      <!-- 结束日期 -->
      <view class="filter-item">
        <text class="filter-label">结束日期</text>
        <picker mode="date" value="{{endTime}}" bindchange="onEndTimeChange">
          <view class="picker-value">
            {{endTime || '选择日期'}}
          </view>
        </picker>
      </view>
    </view>
    
    <!-- 操作按钮 -->
    <view class="filter-actions">
      <button class="btn-reset" bindtap="resetFilter">重置</button>
      <button class="btn-apply" bindtap="applyFilter">应用</button>
    </view>
  </view>

  <!-- 当前筛选条件提示 -->
  <view wx:if="{{!showFilterPanel && (groupName || startTime || endTime || !onlyMembers)}}" class="filter-tags">
    <view wx:if="{{!onlyMembers}}" class="tag">全部成员</view>
    <view wx:if="{{groupName}}" class="tag">{{groupName}}</view>
    <view wx:if="{{startTime}}" class="tag">{{startTime}}起</view>
    <view wx:if="{{endTime}}" class="tag">至{{endTime}}</view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading && list.length === 0}}" class="loading">
    <view class="loading-text">加载中...</view>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{list.length === 0}}" class="empty">
    <view class="empty-icon">📭</view>
    <view class="empty-text">暂无翻地记录</view>
  </view>

  <!-- 记录列表 -->
  <view wx:else class="record-list">
    <view class="record-item" wx:for="{{list}}" wx:key="id">
      <view class="record-main">
        <view class="record-header">
          <text class="player-name">{{item.player_name}}</text>
          <text class="land-level">Lv.{{item.land_level}}</text>
        </view>
        <view class="record-info">
          <view class="info-row">
            <text class="info-label">土地:</text>
            <text class="info-value">{{item.land_name || '未知'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">坐标:</text>
            <text class="info-value">{{item.posText}}</text>
          </view>
          <view class="info-row" wx:if="{{item.defender_name}}">
            <text class="info-label">防守:</text>
            <text class="info-value">{{item.defender_name}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">时间:</text>
            <text class="info-value">{{item.timeText}}</text>
          </view>
        </view>
      </view>
      <view class="record-status {{item.is_success ? 'success' : 'fail'}}">
        {{item.is_success ? '成功' : '失败'}}
      </view>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{loading}}" class="loading-more">
      <text>加载中...</text>
    </view>
    <view wx:elif="{{!hasMore}}" class="no-more">
      <text>没有更多了</text>
    </view>
  </view>
</view>
