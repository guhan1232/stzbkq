.container {
  padding: 20rpx;
  background: var(--bg-secondary);
  min-height: 100vh;
}

.action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--bg-card);
  padding: 20rpx 30rpx;
  border-radius: var(--radius-lg);
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-soft);
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: var(--gradient-primary);
  color: white;
  border-radius: var(--radius-full);
  font-size: 26rpx;
  font-weight: 500;
}

.filter-btn .icon {
  font-size: 28rpx;
}

.record-count-info {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.filter-panel {
  background: var(--bg-card);
  padding: 30rpx;
  border-radius: var(--radius-lg);
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-soft);
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.filter-section {
  margin-bottom: 30rpx;
}

.filter-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.filter-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.filter-label {
  font-size: 28rpx;
  color: var(--text-primary);
  flex-shrink: 0;
}

.filter-input {
  flex: 1;
  margin-left: 20rpx;
  padding: 12rpx 20rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  color: var(--text-primary);
}

.picker-value {
  flex: 1;
  margin-left: 20rpx;
  padding: 12rpx 20rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  color: var(--text-primary);
  text-align: right;
}

.filter-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.btn-reset, .btn-apply {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.btn-reset {
  background: var(--bg-secondary);
  color: var(--text-primary);
}

.btn-apply {
  background: var(--gradient-primary);
  color: white;
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tag {
  padding: 8rpx 16rpx;
  background: var(--primary-50);
  color: var(--primary-500);
  border-radius: var(--radius-lg);
  font-size: 24rpx;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}

.loading-text {
  color: var(--text-tertiary);
  font-size: 28rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  color: var(--text-tertiary);
  font-size: 28rpx;
}

.record-list {
  margin-top: 20rpx;
}

.record-item {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  padding: 24rpx 30rpx;
  margin-bottom: 16rpx;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-soft);
  transition: all var(--transition-base);
}

.record-item:active {
  transform: scale(0.98);
  background: var(--bg-hover);
}

.record-main {
  flex: 1;
}

.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.player-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.land-level {
  font-size: 24rpx;
  color: var(--primary-500);
  background: var(--primary-50);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
}

.record-info {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.info-row {
  display: flex;
  align-items: center;
}

.info-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-right: 6rpx;
}

.info-value {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.record-status {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 500;
}

.record-status.success {
  background: var(--success-bg);
  color: var(--success);
}

.record-status.fail {
  background: var(--danger-bg);
  color: var(--danger);
}

.loading-more, .no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: var(--text-tertiary);
}
