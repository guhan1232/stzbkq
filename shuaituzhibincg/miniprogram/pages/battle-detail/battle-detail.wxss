.detail-page {
  min-height: 100vh;
  background-color: var(--bg-secondary);
  padding-bottom: 40rpx;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--gray-300);
  border-top-color: var(--primary-500);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--text-tertiary);
}

.battle-card {
  margin: 24rpx;
  background: var(--gradient-primary);
  border-radius: var(--radius-xl);
  padding: 32rpx;
  box-shadow: var(--shadow-glow);
}

.battle-players {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.player {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.player-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.player-info {
  text-align: center;
}

.player-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 6rpx;
}

.player-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 4rpx;
}

.player-union {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.vs-box {
  padding: 0 20rpx;
}

.vs-text {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
}

.info-card {
  margin: 0 24rpx 24rpx;
  background-color: var(--bg-card);
  border-radius: var(--radius-xl);
  overflow: hidden;
  border: 2rpx solid var(--border-color-light);
}

.card-header {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.info-list {
  padding: 8rpx 0;
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.info-left {
  display: flex;
  align-items: center;
}

.info-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

.info-right {
  display: flex;
  align-items: center;
}

.info-value {
  font-size: 28rpx;
  color: var(--text-primary);
}

.copy-btn {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--primary-500);
  padding: 8rpx 16rpx;
  background-color: var(--primary-50);
  border-radius: var(--radius-sm);
}

.result-tag {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-sm);
}

.result-tag.win {
  background-color: var(--success-bg);
  color: var(--success);
}

.result-tag.lose {
  background-color: var(--danger-bg);
  color: var(--danger);
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  color: var(--text-tertiary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-disabled);
}
