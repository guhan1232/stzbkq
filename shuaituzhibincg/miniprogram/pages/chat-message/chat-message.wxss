.container {
  padding: 16rpx;
  padding-bottom: 40rpx;
  background: var(--bg-secondary);
  min-height: 100vh;
}

.top-bar {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}

.capture-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.capture-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.capture-label {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.capture-tag {
  font-size: 20rpx;
  font-weight: bold;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.capture-tag.on {
  background: var(--success-bg);
  color: var(--success);
}

.capture-tag.off {
  background: var(--bg-secondary);
  color: var(--text-disabled);
}

.action-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 6rpx;
  line-height: 1.3;
  margin: 0;
  padding: 0;
}

.btn-xs {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
}

.btn-primary {
  background: var(--success);
  color: white;
}

.btn-danger {
  background: var(--danger);
  color: white;
}

.btn-ghost {
  background: var(--bg-secondary);
  color: var(--text-secondary);
}

.btn-danger-text {
  color: var(--danger);
}

.filter-panel {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  gap: 10rpx;
}

.filter-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  min-width: 60rpx;
}

.filter-input {
  flex: 1;
  height: 56rpx;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 0 14rpx;
  font-size: 24rpx;
}

.filter-btns {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.count-bar {
  padding: 4rpx 8rpx 8rpx;
}

.count-text {
  font-size: 22rpx;
  color: var(--text-disabled);
}

.msg-list {
  margin-top: 4rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 12rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-disabled);
  margin-bottom: 6rpx;
}

.empty-hint {
  font-size: 22rpx;
  color: var(--text-disabled);
}

.msg-item {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  margin-bottom: 8rpx;
}

.msg-row1 {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.msg-alliance {
  font-size: 20rpx;
  color: var(--primary-500);
  background: var(--primary-50);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  white-space: nowrap;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.msg-player {
  font-size: 24rpx;
  font-weight: bold;
  color: var(--text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-time {
  font-size: 20rpx;
  color: var(--text-disabled);
  white-space: nowrap;
}

.msg-row2 {
  padding-left: 0;
}

.msg-content {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  word-break: break-all;
}

.load-tip {
  text-align: center;
  padding: 20rpx;
  font-size: 22rpx;
  color: var(--text-disabled);
}
