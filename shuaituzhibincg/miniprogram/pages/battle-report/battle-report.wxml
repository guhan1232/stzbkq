<!-- 战报查询页面 -->
<view class="page-container">
  <!-- 搜索栏 -->
  <view class="search-box">
    <view class="flex justify-between align-center padding-lr bg-white">
      <view class="flex align-center" bindtap="toggleFilter">
        <text class="text-sm {{atkName || defName || unionName ? 'text-theme' : 'text-gray'}}">{{atkName || defName || unionName ? '已设置筛选' : '点击筛选'}}</text>
        <text class="cuIcon-{{showFilter ? 'fold' : 'unfold'}} margin-left-xs text-gray"></text>
      </view>
      <text class="text-sm text-gray">共 {{total}} 条</text>
    </view>
  </view>

  <!-- 筛选面板 -->
  <view class="bg-white padding-lr {{showFilter ? 'padding-bottom' : ''}}" wx:if="{{showFilter}}">
    <view class="cu-form-group">
      <view class="title">攻击方</view>
      <input placeholder="玩家名" value="{{atkName}}" bindinput="onAtkNameInput" />
    </view>
    <view class="cu-form-group">
      <view class="title">防守方</view>
      <input placeholder="玩家名" value="{{defName}}" bindinput="onDefNameInput" />
    </view>
    <view class="cu-form-group">
      <view class="title">同盟名</view>
      <input placeholder="同盟名" value="{{unionName}}" bindinput="onUnionNameInput" />
    </view>
    <view class="cu-form-group">
      <view class="title">最小血量</view>
      <input type="number" placeholder="数值" value="{{minHp}}" bindinput="onMinHpInput" />
    </view>
    <view class="cu-form-group">
      <view class="title">排除NPC</view>
      <switch checked="{{nonpc}}" bindchange="onNonpcChange" color="#4CAF50" />
    </view>
    <view class="flex padding-top">
      <button class="cu-btn line-gray round flex-sub" bindtap="resetFilter">重置</button>
      <button class="cu-btn bg-theme round flex-sub margin-left" bindtap="doSearch">搜索</button>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="cu-load loading" wx:if="{{loading && list.length === 0}}"></view>

  <!-- 空状态 -->
  <view class="empty-box" wx:elif="{{list.length === 0}}">
    <text class="cuIcon-emoji text-gray" style="font-size: 120rpx;"></text>
    <view class="empty-text">暂无战报数据</view>
  </view>

  <!-- 战报列表 -->
  <view class="padding-bottom-xl" wx:else>
    <view class="cu-card case" wx:for="{{list}}" wx:key="battle_id" bindtap="viewDetail" data-id="{{item.battle_id}}">
      <view class="cu-item">
        <view class="flex align-center">
          <view class="flex-sub text-right padding-right">
            <view class="text-bold text-cut">{{item.attack_name || '未知'}}</view>
            <view class="text-sm text-gray margin-top-xs" wx:if="{{item.attack_hp}}">{{item.attack_hp}}</view>
          </view>
          <view class="cu-tag bg-gray sm round margin-lr">VS</view>
          <view class="flex-sub padding-left">
            <view class="text-bold text-cut">{{item.defend_name || '未知'}}</view>
            <view class="text-sm text-gray margin-top-xs" wx:if="{{item.defend_hp}}">{{item.defend_hp}}</view>
          </view>
        </view>
        <view class="text-center text-sm text-gray margin-top">{{item.timeText}}</view>
      </view>
    </view>
    
    <view class="cu-load {{hasMore ? 'loading' : 'over'}}" wx:if="{{list.length > 0}}"></view>
  </view>
</view>
